<Window x:Class="DrugieOkno.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrugieOkno"
        mc:Ignorable="d"
        Title="Drugie Okno — Panel Zadań" Height="600" Width="900"
        MinHeight="450" MinWidth="680"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="RootGrid" Background="#F4F6F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBorder" Grid.Row="0" Background="#1E293B" Padding="20,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Drugie Okno" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Osobisty panel zadań i szybkich notatek" FontSize="12" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel x:Name="HeaderActionsPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="TasksCard" Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left" Text="Lista zadań" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Button x:Name="ClearCompletedButton" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Content="Wyczyść ukończone" Padding="10,4" FontSize="12"
                                Background="#FEE2E2" Foreground="#B91C1C" BorderBrush="#FCA5A5" BorderThickness="1"
                                Cursor="Hand" Click="ClearCompletedButton_Click"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TaskInputTextBox" Grid.Column="0" Height="34" Padding="10,6" FontSize="13"
                                 VerticalContentAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1"
                                 KeyDown="TaskInputTextBox_KeyDown"/>
                        <ComboBox x:Name="PriorityComboBox" Grid.Column="1" Width="105" Height="34" Margin="8,0,0,0"
                                  VerticalContentAlignment="Center" SelectedIndex="1">
                            <ComboBoxItem Content="Niski"/>
                            <ComboBoxItem Content="Normalny"/>
                            <ComboBoxItem Content="Wysoki"/>
                        </ComboBox>
                        <Button x:Name="AddTaskButton" Grid.Column="2" Content="Dodaj zadanie" Margin="8,0,0,0"
                                Padding="14,6" Height="34" Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand" Click="AddTaskButton_Click"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Szukaj:" Foreground="#475569" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchTextBox" Grid.Column="1" Height="28" Padding="8,4" FontSize="12"
                                 VerticalContentAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1"
                                 TextChanged="SearchTextBox_TextChanged"/>
                        <ComboBox x:Name="FilterComboBox" Grid.Column="2" Width="120" Height="28" Margin="8,0,0,0"
                                  VerticalContentAlignment="Center" SelectedIndex="0" SelectionChanged="FilterComboBox_SelectionChanged">
                            <ComboBoxItem Content="Wszystkie"/>
                            <ComboBoxItem Content="Aktywne"/>
                            <ComboBoxItem Content="Ukończone"/>
                        </ComboBox>
                    </Grid>

                    <ListBox x:Name="TasksListBox" Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="1"
                             FontSize="13" Padding="4" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4,4">
                                    <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button DockPanel.Dock="Right" Content="Usuń" Margin="8,0,0,0" Padding="8,2"
                                            FontSize="11" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1"
                                            BorderThickness="1" Cursor="Hand" Tag="{Binding}" Click="DeleteTaskButton_Click"/>
                                    <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DBEAFE"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Wysoki">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Niski">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Priority}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Wysoki">
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Niski">
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid x:Name="SidePanelGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="NotesCard" Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Szybkie notatki" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10"/>
                        <TextBox x:Name="NotesTextBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Padding="10" FontSize="13"
                                 BorderBrush="#CBD5E1" BorderThickness="1" TextChanged="NotesTextBox_TextChanged"/>
                        <TextBlock x:Name="NotesStatsTextBlock" Grid.Row="2" Text="Znaki: 0 | Słowa: 0"
                                   Foreground="#64748B" FontSize="11" Margin="0,8,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="StatusBorder" Grid.Row="2" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Left" Text="Gotowy" Foreground="#334155" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel x:Name="StatusRightPanel" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TasksSummaryTextBlock" Text="Zadania: 0 | Ukończone: 0 | Pozostałe: 0" Foreground="#334155" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="6,0"/>
                    <TextBlock x:Name="ClockTextBlock" Text="00:00:00" Foreground="#334155" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
