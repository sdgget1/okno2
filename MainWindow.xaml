<Window x:Class="DrugieOkno.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrugieOkno"
        mc:Ignorable="d"
        Title="Drugie Okno — Panel Zadań" Height="600" Width="900"
        MinHeight="450" MinWidth="680"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="RootGrid" Background="#F4F6F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBorder" Grid.Row="0" Background="#1E293B" Padding="20,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Drugie Okno" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Osobisty panel zadań i szybkich notatek" FontSize="12" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel x:Name="HeaderActionsPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="20,16">
            <Border x:Name="TasksCard" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Lista zadań" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TaskInputTextBox" Grid.Column="0" Height="34" Padding="10,6" FontSize="13"
                                 VerticalContentAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1"
                                 KeyDown="TaskInputTextBox_KeyDown"/>
                        <Button x:Name="AddTaskButton" Grid.Column="1" Content="Dodaj zadanie" Margin="8,0,0,0"
                                Padding="14,6" Height="34" Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand" Click="AddTaskButton_Click"/>
                    </Grid>

                    <ListBox x:Name="TasksListBox" Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1"
                             FontSize="13" Padding="4" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4,4">
                                    <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="StatusBorder" Grid.Row="2" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Left" Text="Gotowy" Foreground="#334155" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel x:Name="StatusRightPanel" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockTextBlock" Text="00:00:00" Foreground="#334155" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
